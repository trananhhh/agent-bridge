{
  "name": "@trananhhh/agent-bridge",
  "version": "0.8.1",
  "private": true,
  "description": "Let Claude Code agents on different machines talk to each other over Tailscale",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agent-bridge": "bin/agent-bridge.js",
    "claude-bridge": "bin/claude-bridge.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "hono": "^4.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.8.2",
    "vitest": "^3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trananhhh/agent-bridge.git"
  },
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "README.md",
    "SETUP.md"
  ]
}
